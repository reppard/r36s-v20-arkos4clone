#!/usr/bin/python3
import fcntl
import os
import sys

REGMAP = "/sys/kernel/debug/regmap/0-0020-rk817-codec/"
STATE = "/var/local/rk817-codec.state"
CODEC_REGS = range(0x15, 0x50)
I2C_SLAVE_FORCE = 0x0706
RK817_ADDR = 0x20


def read_hw():
    with open(REGMAP + "cache_bypass", "w") as f:
        f.write("Y")
    try:
        with open(REGMAP + "registers") as f:
            lines = f.read().splitlines()
    finally:
        with open(REGMAP + "cache_bypass", "w") as f:
            f.write("N")
    regs = {}
    for line in lines:
        reg, _, val = line.partition(": ")
        if val and val != "XX" and int(reg, 16) in CODEC_REGS:
            regs[int(reg, 16)] = int(val, 16)
    return regs


def save():
    with open(STATE, "w") as f:
        f.writelines(f"{r:02x} {v:02x}\n" for r, v in sorted(read_hw().items()))


def restore():
    with open(STATE) as f:
        saved = {int(r, 16): int(v, 16) for r, v in (line.split() for line in f)}
    current = read_hw()
    fd = os.open("/dev/i2c-0", os.O_RDWR)
    try:
        fcntl.ioctl(fd, I2C_SLAVE_FORCE, RK817_ADDR)
        for reg in sorted(saved):
            if current.get(reg) != saved[reg]:
                os.write(fd, bytes([reg, saved[reg]]))
    finally:
        os.close(fd)


if sys.argv[1] == "pre":
    save()
elif sys.argv[1] == "post" and os.path.exists(STATE):
    restore()
